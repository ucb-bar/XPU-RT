/* Bare-metal FireSim / Spike harness for XPU-RT's embedded runtime.
 *
 * Links against picolibc + libgloss_htif (Chipyard's riscv-tools conda
 * env), so plain printf routes through HTIF and FireSim's front-end
 * captures the output in ``results-workload/.../uartlog``. The program
 * exits cleanly via return from main() — libgloss_htif translates that
 * into a ``tohost = 1`` poweroff.
 *
 * Template substitution (done at emit time by
 * ``xpu_rt.extensions.firesim.build_workload``):
 *
 *   @ARENA_BYTES@  -> arena size the lowered model requires
 *   @INPUT_BYTES@  -> XPU_RT_MODEL_INPUT_BYTES (from xpu_rt_model.h)
 *   @OUTPUT_BYTES@ -> XPU_RT_MODEL_OUTPUT_BYTES
 *
 * The golden input tensor is supplied as a separate translation unit
 * (input_blob.c, emitted beside this file) exposing
 * ``xpu_rt_input_bytes[XPU_RT_MODEL_INPUT_BYTES]``.
 */

#include <stdint.h>
#include <stddef.h>
#include <stdio.h>
#include <string.h>

#include "xpu_rt_model.h"

/* Provided by the adjacent input_blob.c. */
extern const uint8_t xpu_rt_input_bytes[];

/* Cycle counter helper — FireSim's Rocket/Shuttle cores expose rdcycle. */
static inline uint64_t xpu_rt_rdcycle(void) {
    uint64_t c;
    __asm__ volatile ("rdcycle %0" : "=r"(c));
    return c;
}

static uint8_t xpu_rt_arena [@ARENA_BYTES@]  __attribute__((aligned(16)));
static uint8_t xpu_rt_input [@INPUT_BYTES@]  __attribute__((aligned(16)));
static uint8_t xpu-rt-output[@OUTPUT_BYTES@] __attribute__((aligned(16)));

int main(void) {
    printf("xpu_rt: boot in=%u out=%u arena=%u\n",
           (unsigned)sizeof(xpu_rt_input),
           (unsigned)sizeof(xpu-rt-output),
           (unsigned)sizeof(xpu_rt_arena));
    fflush(stdout);

    memcpy(xpu_rt_input, xpu_rt_input_bytes, sizeof(xpu_rt_input));

    int rc = xpu_rt_init(xpu_rt_arena, sizeof(xpu_rt_arena));
    printf("xpu_rt: init rc=%d\n", rc);
    fflush(stdout);
    if (rc != 0) return rc;

    uint64_t t0 = xpu_rt_rdcycle();
    rc = xpu_rt_invoke(xpu_rt_input, sizeof(xpu_rt_input),
                        xpu-rt-output, sizeof(xpu-rt-output));
    uint64_t t1 = xpu_rt_rdcycle();
    printf("xpu_rt: invoke rc=%d cycles=%llu\n",
           rc, (unsigned long long)(t1 - t0));
    fflush(stdout);
    if (rc != 0) return rc;

    /* Full output bytes as hex — the host diffs against golden_outputs.pt. */
    printf("xpu_rt: out_hex=");
    for (size_t i = 0; i < sizeof(xpu-rt-output); ++i) {
        printf("%02x", xpu-rt-output[i]);
    }
    printf("\nxpu_rt: done\n");
    fflush(stdout);

    xpu_rt_shutdown();
    return 0;
}
