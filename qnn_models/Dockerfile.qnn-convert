FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install system Python 3.10 and LLVM runtime (exact match for QNN SDK build env)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-dev \
    python3-pip \
    libc++-dev \
    libc++abi-dev \
    libatomic1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages needed by the converter
RUN python3.10 -m pip install --no-cache-dir \
    numpy \
    onnx \
    pyyaml \
    pandas \
    packaging

# SDK will be bind-mounted at /qnn
ENV QNN_SDK_ROOT=/qnn
ENV PYTHONPATH=/qnn/lib/python:${PYTHONPATH}
ENV PATH=/qnn/bin/x86_64-linux-clang:${PATH}
ENV LD_LIBRARY_PATH=/qnn/lib/x86_64-linux-clang:${LD_LIBRARY_PATH}

WORKDIR /workspace
