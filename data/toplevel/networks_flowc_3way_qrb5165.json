{
  "_comment": "The same three networks the RISC-V flow runs (mlp_control, dronet, yolo), on the QRB5165's three lanes. dronet and mlp_control are ingested from modelblaster's model zoo \u2014 one PyTorch definition, one checkpoint, feeding both flows. yolov8n comes in through the graph_json door because the network that exists on this board is the 640x640 ultralytics export behind the QNN converter, not modelblaster's 64x64 yolov8_nano.",
  "hardware": {
    "machines": {
      "cpu_p": 1,
      "cpu_e": 1,
      "cpu_x": 1
    },
    "profile_hw": {
      "cpu_p": "HTA",
      "cpu_e": "DSP",
      "cpu_x": "CPU"
    },
    "profile": {
      "target": "qrb5165_flowc",
      "topo_tag": "topo_0",
      "topo_tag_override": false,
      "gen_root": "gen"
    },
    "p_core_speedup": 1.0
  },
  "scheduler": {
    "random_seed": 42,
    "solver_verbosity": 0,
    "time_limit": 60,
    "use_profiled": true,
    "prune_periodic": true,
    "restrict_makespan_to_nonperiodic": true
  },
  "networks": {
    "dronet": {
      "id": 0,
      "identifier": "dronet",
      "dispatch_deps_path": "gen/qnn_vmfb/dronet/qrb5165_flowc/CPU/dronet.int8/dronet.int8_dispatch_graph.json",
      "period": 5,
      "window_duration": 5,
      "num_instances": 15
    },
    "mlp_control": {
      "id": 1,
      "identifier": "mlp_control",
      "dispatch_deps_path": "gen/qnn_vmfb/mlp_control/qrb5165_flowc/CPU/mlp_control.int8/mlp_control.int8_dispatch_graph.json",
      "period": 2,
      "window_duration": 2,
      "num_instances": 37
    },
    "yolov8n": {
      "id": 2,
      "identifier": "yolov8n",
      "dispatch_deps_path": "gen/qnn_vmfb/yolov8n/qrb5165_flowc/CPU/yolov8n.int8/yolov8n.int8_dispatch_graph.json"
    }
  },
