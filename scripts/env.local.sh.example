# shellcheck shell=bash
# Copy to scripts/env.local.sh (ignored by git) and edit. scripts/env.sh sources it before
# applying its defaults; the ${VAR:-...} form lets an explicit environment variable
# (XPURT_SIM_TREE=... scripts/foo.sh) win over the value written here.
#
# Every value below is a path on the machine you are running on. With none of them set,
# scripts/env.sh points SIM_TREE and TRAIN_OUT at this checkout and ISAAC_PY at `python`,
# which is right for a clone that has the sims/IsaacLab submodule and an Isaac interpreter
# on PATH. The commented lines are the values the study itself ran with, kept as an example
# of the shape each one takes.

# the tree holding sims/IsaacLab and sims/scripts, when the flights run from a separate checkout
XPURT_SIM_TREE="${XPURT_SIM_TREE:-$REPO}"
#XPURT_SIM_TREE="/scratch/<user>/projects/DIMA/XPU-RT"

# the Isaac Sim / IsaacLab interpreter (a conda env, typically)
ISAAC_PY="${ISAAC_PY:-python}"
#ISAAC_PY="/scratch2/<user>/miniforge3/envs/env_isaaclab/bin/python"

# where the training drivers write checkpoints
XPURT_TRAIN_OUT="${XPURT_TRAIN_OUT:-$REPO/train_out}"
#XPURT_TRAIN_OUT="/scratch/<user>/projects/DIMA/train_out"

# Read by the Python drivers rather than by env.sh; export them if the defaults do not suit.
# XPURT_SCRATCH      where intermediates land                 (default: $TMPDIR)
# XPURT_RSL_RL_LOGS  the rsl_rl run tree with the inner-loop   (default: logs/rsl_rl)
#                    steering checkpoints
# ISAACLAB_SOURCE    an IsaacLab source/ outside the submodule (default: sims/IsaacLab/source)
# MODELBLASTER_ROOT  a ModelBlaster outside the submodule      (default: ./ModelBlaster)

# RISC-V cross toolchain prefix for the ModelBlaster board scripts (default: found on PATH)
# export CROSS=/path/to/riscv-tools/bin/riscv64-unknown-linux-gnu-

# The vitfly checkout's models/ dir (fused_model.py), for ModelBlaster/models/_fused_loader.py
# (required there) and the fused-perception drivers (default there: ../vitfly/models)
# export MODELBLASTER_VITFLY_MODELS=/path/to/vitfly/models

# The FireSim-era ModelBlaster scripts (setup_benchmark_env.sh, the run_*_capture.sh queue
# drivers, bedrock_spike_loop.py, spike_verify_kernel.py); see ModelBlaster/README.md
# export CHIPYARD_ROOT=/path/to/chipyard          # FIRESIM_ROOT defaults to $CHIPYARD_ROOT/sims/firesim
# export ZEPHYR_BASE=/path/to/zephyr-chipyard-sw/zephyr_ws/zephyr
# MODELBLASTER_HETERO_SPIKE  spike-hetero for bedrock_spike_loop.py (default: on PATH)
# FIRESIM_QUEUE_BIN          the shared FPGA queue client        (default: firesim-queue on PATH)
# XPURT_ROOT                 the XPU-RT tree the ModelBlaster scripts read (default: this checkout)

# Retired sims/scripts/attic/inspect_meshes_offline.py: the two reference checkouts it renders
# CRL_DRONE_RACING_ROOT=/path/to/CRL-Drone-Racing  AERIAL_GYM_ROOT=/path/to/aerial_gym_simulator
