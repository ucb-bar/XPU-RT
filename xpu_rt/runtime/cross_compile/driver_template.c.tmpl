/* Per-region static input/output buffers. Sizes are baked at
 * compile time from each region's kernel contract. */
%%REGION_BUFFERS%%

static uint64_t fnv1a_u64(const void* data, size_t bytes) {
    const uint8_t* p = (const uint8_t*)data;
    uint64_t h = 0xcbf29ce484222325ULL;
    for (size_t i = 0; i < bytes; ++i) {
        h ^= p[i];
        h *= 0x100000001b3ULL;
    }
    return h;
}

static void emit_output_hex(const float* out, size_t n) {
    printf("output_count: %lu\n", (unsigned long)n);
    for (size_t i = 0; i < n; ++i) {
        uint32_t bits;
        memcpy(&bits, &out[i], sizeof(bits));
        printf("%s%08lx", (i == 0 ? "output: " : " "), (unsigned long)bits);
    }
    printf("\n");
    uint64_t cs = fnv1a_u64(out, n * sizeof(float));
    printf("checksum: 0x%08lx%08lx\n",
           (unsigned long)(cs >> 32),
           (unsigned long)(cs & 0xffffffffUL));
}

