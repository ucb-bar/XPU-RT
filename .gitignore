__pycache__/
*/plots/

# Runtime build output and local test data
runtime/build/
runtime/build-host/
runtime/build-spacemit/
runtime/dispatch_from_schedule_async/
.ve

# Session/audit notes for docs -- process commentary, not user-facing docs
docs/*_status.md

# MOSEK license — machine-local, never commit
*.lic

# generated packaging metadata
*.egg-info/

# freshness sweep scratch: materialised per-cell workload configs
data/toplevel/_fx_*.json
# per-cell solver logs are large and regenerable
results/freshness_eval/work/

# Full-history safety bundles: hundreds of MB, local restore aids, and larger
# than GitHub accepts. The 28 KB artifacts/repo_reconciliation/zephyr-patches/
# bundle is deliberately NOT ignored -- it carries commits that exist on no
# remote and is small enough to live in git.
artifacts/repo_reconciliation/*.bundle

# Solver output. Every file here is regenerated by re-solving the spec that
# produced it, and the spec IS tracked (data/toplevel/), so the input is in git
# and the output is not -- same rule as plots/, figures/ and artifacts/.
#
# This supersedes the narrower `schedules/*_report.json` rule that preceded it,
# which existed only because the reports are ~680K each.
/schedules/*
!/schedules/scheduled_networks_k1_tri_exact_100ms_greedy_profiled.json
!/schedules/scheduled_networks_k1_tri_exact_100ms_feedback_greedy_profiled.json
# ...and the two that plot_v3_bundles_vs_baseline.py opens by exact path.
# These cannot be regenerated on dev: gen/ was removed in 2717755e, so the
# profiles the scheduler reads are no longer here. 68 KB so the figure
# reproduces from a clean clone.
!/schedules/scheduled_networks_smolvla_vision_v3_bundles_qrb5165_greedy_profiled.json
!/schedules/scheduled_networks_smolvla_vision_v3_qrb5165_greedy_profiled.json

# ---------------------------------------------------------------------------
# Working output. None of this is outward-facing: it is generated, it is
# regenerable from the code and the board, and a fresh clone has no use for it.
# It all still exists on disk -- ignoring is not deleting.
# ---------------------------------------------------------------------------

# Generated figures. `*/plots/` above only catches a plots/ dir nested one
# level down; the top-level one is where every scheduler run writes its Gantt.
/plots/

# Report figures. plot_k1_evolution.py used to write into paper/figures/;
# there is no paper/ in this repo any more.
/out/

# Lab notebook: board traces, per-round measurements, progress notes, host
# verification records. The evidence behind a claim lives here, and the claim
# itself lives in the commit message that cites it.
#
# ONE EXCEPTION, and it is deliberate: artifacts/repo_reconciliation/
# zephyr-patches/zephyr-3commits.bundle carries commits that exist on no
# remote. It stays in the index, and a tracked file is unaffected by a
# gitignore rule, so the pattern below does not reach it.
/artifacts/

# LaTeX sources and build products do not belong in the runtime repo.
/paper/

# Editor, agent and tooling local state.
/.claude/
/.vscode/
/.mcp.json
/uv.lock

# Build trees and scratch. No tracked content in any of them.
/build/
/compgen_output/
/sessions/
/tmp/

# Model weights are inputs, not source: yolov8n.pt is 6.5 MB of downloadable
# checkpoint and data/models/ is where the rest land.
/yolov8n.pt
/data/models/
/data/training/
# LLM response cache for kernel synthesis: regenerable, and can carry prompt
# text that has no reason to be in a public repo.
/data/llm_cache/

# gen/ is deliberately NOT blanket-ignored. It holds 44 TRACKED files -- the
# qrb5165 and spacemit profiles that the benchmarks are anchored on, and the
# ModelBlaster dispatch graphs that every network spec's `dispatch_deps_path`
# points at. Ignoring the tree wholesale made a gitignore rule shadow tracked
# data, which is confusing rather than clean.
#
# Only the one subtree with no tracked content at all:
/gen/profile_hybrid/

# Ad-hoc feasibility probes: derived specs written to answer one question,
# alongside the _fx_ sweep configs.
data/toplevel/_probe_*.json
/schedules/scheduled__probe_*

# Freshness-sweep per-cell solver output, matching the existing
# data/toplevel/_fx_*.json rule for the configs that produced it. Scoped to
# `.json` on purpose: the `.json.cfgsha256` siblings ARE tracked (they are the
# config fingerprint that says which sweep cell a result belongs to), and a
# rule that shadowed them would be worse than no rule.
/schedules/scheduled__fx_*.json

# Generated figures, same category as /plots/.
/figures/

# Board and profiler output trees that contain NO tracked file. Listed
# individually rather than as `gen/*`, because gen/ also holds the tracked
# qrb5165/spacemit profiles and the dispatch graphs every network spec points
# at -- see the note above. Each path below was checked with `git ls-files`.
/gen/profile/IME/
/gen/profile/RVV/spacemit_x60/
/gen/profile/RVV_c1/
/gen/profile/RVV_fused/
/gen/profile/scalar/spacemit_x60/
/gen/profile/scalar_c1/
# NOT /gen/profile_mb/. That tree is what `gen_mb/profile` symlinks to, and
# it is the MEASURED COST DATABASE THE SCHEDULER INGESTS -- every solve in this
# repo reads it, and each schedule records the exact files it read in
# `metadata.pdb_files`. It was ignored under the rule above, on the reasoning
# that it contained no tracked file; that reasoning is circular, and the effect
# was that 18 of 21 measured profiles were absent from a clean clone while
# every recorded verdict had been computed from them. `pdb_hash` proves WHICH
# costs a solve read; it cannot reconstruct them. 256 KB of CSV is a small
# price for the numbers the whole project rests on being reproducible.
/gen/vmfb/dronet/spacemit_x60/
/gen/vmfb/mlp/
/gen/vmfb/yolov8_nano/

# NOT /gen25/ or /gen_mb/. Both were blanket-ignored in 230614c6 while they
# held no tracked file; restoring them showed why that is wrong. gen_mb/vmfb
# holds the dispatch graphs run_exact_cycle_feedback.py reads, and
# gen_mb/profile is a SYMLINK to gen/profile_mb, the measured cost database.
# The ignore rule then shadowed the very data the flagship result needs --
# the same mistake the /gen/profile_mb/ note above describes.

# Figures are build products: a committed script plus measured data in the
# repo reproduces every one of them. `scripts/figstyle.py` fixes the style.
out/figures/

# merlin is no longer a submodule: nothing on the live K1 path imports it,
# and the one thing that did -- the SpaceMiT cross toolchain -- is now fetched
# by scripts/setup_spacemit_toolchain.sh. A local checkout may still be present
# for the retired IREE/runtime flow; it is not tracked.
/merlin/

# Downloaded cross toolchain (6 GB). scripts/setup_spacemit_toolchain.sh
# fetches it here on demand; it is an artifact, never a commit.
/tools/riscv-tools-spacemit/

# Inward-facing working notes: session narrative, blockers, post-mortems.
# Useful to keep locally, not repo documentation -- committing it publishes
# an internal account as if it were a changelog.
/docs/CHANGES.md
/docs/merging_to_dev.md
